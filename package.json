{
  "name": "@api-central/sdk",
  "version": "2.0.0",
  "description": "Official SDK for API Central S2S - Messaging, Notifications, Support, Live Streaming & Calls",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --exclude src/__tests__/integration.test.ts",
    "test:unit": "vitest run --exclude src/__tests__/integration.test.ts",
    "test:integration": "vitest run src/__tests__/integration.test.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "api-central",
    "sdk",
    "messaging",
    "notifications",
    "support",
    "live-streaming",
    "video-calls",
    "typescript"
  ],
  "author": "API Central Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goncoolio/api-central-sdk-js.git"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "livekit-client": "^2.22.3",
    "prettier": "^3.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  },
  "peerDependencies": {
    "livekit-client": "^2.22.0",
    "typescript": ">=4.7.0"
  },
  "peerDependenciesMeta": {
    "livekit-client": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "homepage": "https://github.com/goncoolio/api-central-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/goncoolio/api-central-sdk-js/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
